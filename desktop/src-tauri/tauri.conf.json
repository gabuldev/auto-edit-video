{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto-Edit",
  "version": "0.1.0",
  "identifier": "dev.gabul.autoedit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Auto-Edit",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:8760 http://localhost:8760; media-src 'self' http://127.0.0.1:8760 http://localhost:8760; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://api.github.com http://127.0.0.1:8760 http://localhost:8760"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMkZCODRERDVGQUQyODkKUldTSjB2clZUYmd2YTR6dkdnWUk4b3FZdWlQeHRsUWlCUGFINnJoNzVoajA0L2RISWxhUzBXeUYK",
      "endpoints": [
        "https://github.com/gabuldev/auto-edit-video/releases/latest/download/latest.json"
      ]
    }
  }
}
